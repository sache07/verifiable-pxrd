data_from_pyxtal

_symmetry_space_group_name_H-M 'P21/m'
_symmetry_Int_Tables_number                   11
_symmetry_cell_setting                monoclinic
_cell_length_a           10.820800
_cell_length_b            4.171400
_cell_length_c           13.531733
_cell_angle_alpha        90.000000
_cell_angle_beta        101.187553
_cell_angle_gamma        90.000000
_cell_volume            599.187115

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z'
3 '-x, -y, -z'
4 'x, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Al     Al       2     0.243911    0.250000    0.128015 1
Cl     Cl       4     0.021151    0.008769    0.386652 1
Cl     Cl       4     0.249104    0.012425    0.753817 1
Se     Se       2     0.355201    0.250000    0.536190 1
Se     Se       2     0.847700    0.250000    0.821149 1
Br     Br       2     0.451393    0.250000    0.249142 1
Bi     Bi       2     0.386729    0.250000    0.978475 1
Bi     Bi       2     0.625142    0.250000    0.602587 1
