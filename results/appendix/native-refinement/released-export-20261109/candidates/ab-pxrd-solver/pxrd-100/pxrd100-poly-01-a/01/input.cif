data_from_pyxtal

_symmetry_space_group_name_H-M 'Pna21'
_symmetry_Int_Tables_number                   33
_symmetry_cell_setting              orthorhombic
_cell_length_a            8.808236
_cell_length_b           14.518330
_cell_length_c            3.885771
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            496.915857

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z+1/2'
3 'x+1/2, -y+1/2, z'
4 '-x+1/2, y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
S      S        4     0.229491    0.712138    0.698442 1
S      S        4     0.527207    0.602764    0.198963 1
S      S        4     0.679019    0.003497    0.202269 1
Ba     Ba       4     0.552389    0.172642    0.697646 1
Hf     Hf       4     0.655456    0.440948    0.202680 1
#END

