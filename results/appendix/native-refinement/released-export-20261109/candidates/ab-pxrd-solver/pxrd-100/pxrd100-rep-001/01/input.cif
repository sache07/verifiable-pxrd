data_from_pyxtal

_symmetry_space_group_name_H-M 'P21'
_symmetry_Int_Tables_number                    4
_symmetry_cell_setting                monoclinic
_cell_length_a            6.723033
_cell_length_b            3.600500
_cell_length_c            6.785200
_cell_angle_alpha        90.000000
_cell_angle_beta        113.626300
_cell_angle_gamma        90.000000
_cell_volume            150.477286

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        2     0.175161    0.041953    0.090154 1
O      O        2     0.148821    0.540940    0.699109 1
Ag     Ag       2     0.488331    0.548749    0.818355 1
Bi     Bi       2     0.037978    0.535024    0.252647 1
#END

