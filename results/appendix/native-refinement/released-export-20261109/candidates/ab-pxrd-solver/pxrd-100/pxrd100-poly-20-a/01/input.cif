data_from_pyxtal

_symmetry_space_group_name_H-M 'Amm2'
_symmetry_Int_Tables_number                   38
_symmetry_cell_setting              orthorhombic
_cell_length_a            6.092051
_cell_length_b            3.794877
_cell_length_c           19.248466
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            444.997199

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x, -y, z'
4 '-x, y, z'
5 'x, y+1/2, z+1/2'
6 '-x, -y+1/2, z+1/2'
7 'x, -y+1/2, z+1/2'
8 '-x, y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Mg     Mg       2     0.500000    0.000000    0.373251 1
Yb     Yb       2     0.500000    0.000000    0.210129 1
Yb     Yb       2     0.000000    0.000000    0.113777 1
Yb     Yb       2     0.500000    0.000000    0.546389 1
Yb     Yb       2     0.000000    0.000000    0.783588 1
Yb     Yb       2     0.000000    0.000000    0.446550 1
