data_from_pyxtal

_symmetry_space_group_name_H-M 'Pmmn'
_symmetry_Int_Tables_number                   59
_symmetry_cell_setting              orthorhombic
_cell_length_a            4.212512
_cell_length_b            6.195639
_cell_length_c           12.665156
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            330.550455

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y+1/2, z'
3 '-x, y+1/2, -z'
4 'x+1/2, -y, -z'
5 '-x, -y, -z'
6 'x+1/2, y+1/2, -z'
7 'x, -y+1/2, z'
8 '-x+1/2, y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
F      F        8     0.004440    0.979697    0.646159 1
F      F        4     0.250000    0.038214    0.107928 1
K      K        2     0.250000    0.250000    0.529218 1
K      K        2     0.250000    0.750000    0.980037 1
Th     Th       2     0.250000    0.250000    0.259443 1
#END

