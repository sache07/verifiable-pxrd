data_from_pyxtal

_symmetry_space_group_name_H-M 'P213'
_symmetry_Int_Tables_number                  198
_symmetry_cell_setting                     cubic
_cell_length_a            6.707160
_cell_length_b            6.707160
_cell_length_c            6.707160
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            301.728268

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y, z+1/2'
3 '-x, y+1/2, -z+1/2'
4 'x+1/2, -y+1/2, -z'
5 'z, x, y'
6 'z+1/2, -x+1/2, -y'
7 '-z+1/2, -x, y+1/2'
8 '-z, x+1/2, -y+1/2'
9 'y, z, x'
10 '-y, z+1/2, -x+1/2'
11 'y+1/2, -z+1/2, -x'
12 '-y+1/2, -z, x+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Sb     Sb       4     0.121650    0.121650    0.121650 1
Pt     Pt       4     0.515070    0.515070    0.515070 1
Bi     Bi       4     0.866954    0.866954    0.866954 1
#END

