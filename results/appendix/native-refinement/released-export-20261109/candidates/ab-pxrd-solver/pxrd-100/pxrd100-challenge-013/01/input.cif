data_from_pyxtal

_symmetry_space_group_name_H-M 'P3212'
_symmetry_Int_Tables_number                  153
_symmetry_cell_setting                  trigonal
_cell_length_a            4.851587
_cell_length_b            4.851587
_cell_length_c            6.733885
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            137.266323

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z+2/3'
3 '-x+y, -x, z+1/3'
4 '-y, -x, -z+1/3'
5 '-x+y, y, -z+2/3'
6 'x, x-y, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Al     Al       3     0.830256   -0.830256    0.166667 1
Ge     Ge       3     0.165332   -0.165332    0.166667 1
Mo     Mo       3     0.502460   -0.502460    0.166667 1
#END

