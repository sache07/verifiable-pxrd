data_from_pyxtal

_symmetry_space_group_name_H-M 'Cm'
_symmetry_Int_Tables_number                    8
_symmetry_cell_setting                monoclinic
_cell_length_a            6.221900
_cell_length_b            6.225200
_cell_length_c           10.044400
_cell_angle_alpha        90.000000
_cell_angle_beta         90.080000
_cell_angle_gamma        90.000000
_cell_volume            389.045066

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 'x, -y, z'
3 'x+1/2, y+1/2, z'
4 'x+1/2, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ge     Ge       4     0.626396    0.720029    0.643851 1
Ge     Ge       2     0.369174    0.000000    0.285253 1
Ge     Ge       2     0.374091    0.000000    0.016982 1
La     La       2     0.885186    0.000000    0.905631 1
Ce     Ce       2     0.869460    0.000000    0.394997 1
Pt     Pt       4     0.616448    0.254267    0.153667 1
Pt     Pt       2     0.411849    0.000000    0.515565 1
Pt     Pt       2     0.437887    0.000000    0.786536 1
