data_from_pyxtal

_symmetry_space_group_name_H-M 'Pmmm'
_symmetry_Int_Tables_number                   47
_symmetry_cell_setting              orthorhombic
_cell_length_a            3.752429
_cell_length_b           10.511759
_cell_length_c           35.604876
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume           1404.421113

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-x, y, -z'
4 'x, -y, -z'
5 '-x, -y, -z'
6 'x, y, -z'
7 'x, -y, z'
8 '-x, y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
H      H        2     0.666624    0.500000    0.500000 1
H      H        2     0.768108    0.000000    0.500000 1
H      H        1     0.500000    0.000000    0.500000 1
H      H        1     0.000000    0.500000    0.500000 1
N      N        2     0.641431    0.000000    0.000000 1
F      F        2     0.833346    0.500000    0.000000 1
F      F        1     0.500000    0.500000    0.000000 1
