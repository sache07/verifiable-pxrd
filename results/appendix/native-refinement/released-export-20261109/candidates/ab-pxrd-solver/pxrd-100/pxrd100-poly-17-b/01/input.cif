data_from_pyxtal

_symmetry_space_group_name_H-M 'Pc'
_symmetry_Int_Tables_number                    7
_symmetry_cell_setting                monoclinic
_cell_length_a            5.481532
_cell_length_b            4.270400
_cell_length_c            5.227500
_cell_angle_alpha        90.000000
_cell_angle_beta        116.564006
_cell_angle_gamma        90.000000
_cell_volume            109.449438

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 'x, -y, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ti     Ti       2     0.354600    0.000432    0.541234 1
Ti     Ti       2     0.943238    0.495461    0.758777 1
Ni     Ni       2     0.818667    0.004033    0.971592 1
Ni     Ni       2     0.483495    0.497283    0.328397 1
