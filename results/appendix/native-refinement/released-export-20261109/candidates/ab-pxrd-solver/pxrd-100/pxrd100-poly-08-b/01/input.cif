data_from_pyxtal

_symmetry_space_group_name_H-M 'C2'
_symmetry_Int_Tables_number                    5
_symmetry_cell_setting                monoclinic
_cell_length_a            7.640200
_cell_length_b            7.331600
_cell_length_c            6.420100
_cell_angle_alpha        90.000000
_cell_angle_beta         90.690000
_cell_angle_gamma        90.000000
_cell_volume            359.595120

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 'x+1/2, y+1/2, z'
4 '-x+1/2, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Li     Li       4     0.739201    0.018780    0.243445 1
Li     Li       2     0.000000    0.756333    0.500000 1
O      O        4     0.505634    0.133583    0.212921 1
O      O        4     0.179916    0.885644    0.993015 1
O      O        4     0.548458    0.730652    0.706698 1
O      O        4     0.168165    0.971517    0.470351 1
Si     Si       2     0.000000    0.765114    0.000000 1
Si     Si       2     0.000000    0.113224    0.500000 1
Fe     Fe       4     0.320208    0.942489    0.232652 1
