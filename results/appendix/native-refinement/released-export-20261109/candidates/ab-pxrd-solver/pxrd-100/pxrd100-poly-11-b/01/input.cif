data_from_pyxtal

_symmetry_space_group_name_H-M 'I41/a'
_symmetry_Int_Tables_number                   88
_symmetry_cell_setting                tetragonal
_cell_length_a            4.968886
_cell_length_b            4.968886
_cell_length_c            9.972465
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            246.218503

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y, z+1/2'
3 '-y+3/4, x+1/4, z+1/4'
4 'y+3/4, -x+3/4, z+3/4'
5 '-x, -y, -z'
6 'x+1/2, y, -z+1/2'
7 'y+1/4, -x+3/4, -z+3/4'
8 '-y+1/4, x+1/4, -z+1/4'
9 'x+1/2, y+1/2, z+1/2'
10 '-x+1, -y+1/2, z+1'
11 '-y+5/4, x+3/4, z+3/4'
12 'y+5/4, -x+5/4, z+5/4'
13 '-x+1/2, -y+1/2, -z+1/2'
14 'x+1, y+1/2, -z+1'
15 'y+3/4, -x+5/4, -z+5/4'
16 '-y+3/4, x+3/4, -z+3/4'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Li     Li       4     0.000000    0.250000    0.625000 1
F      F       16     0.810120    0.034115    0.289709 1
V      V        4     0.000000    0.250000    0.125000 1
#END

