data_from_pyxtal

_symmetry_space_group_name_H-M 'P21'
_symmetry_Int_Tables_number                    4
_symmetry_cell_setting                monoclinic
_cell_length_a            4.591500
_cell_length_b           12.024300
_cell_length_c            8.390594
_cell_angle_alpha        90.000000
_cell_angle_beta        105.819427
_cell_angle_gamma        90.000000
_cell_volume            445.696137

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Rb     Rb       2     0.715641    0.929353    0.496904 1
Sb     Sb       2     0.025552    0.715124    0.057305 1
Te     Te       2     0.698077    0.647075    0.305468 1
Te     Te       2     0.444556    0.726596    0.790340 1
Te     Te       2     0.946886    0.447617    0.868938 1
Hg     Hg       2     0.576275    0.450901    0.110669 1
