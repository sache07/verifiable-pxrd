data_from_pyxtal

_symmetry_space_group_name_H-M 'P21/c'
_symmetry_Int_Tables_number                   14
_symmetry_cell_setting                monoclinic
_cell_length_a            5.738735
_cell_length_b            5.711600
_cell_length_c            5.813700
_cell_angle_alpha        90.000000
_cell_angle_beta        112.656124
_cell_angle_gamma        90.000000
_cell_volume            175.853029

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z+1/2'
3 '-x, -y, -z'
4 'x, -y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
P      P        4     0.145048    0.142455    0.827545 1
Fe     Fe       4     0.779623    0.505374    0.293365 1
Se     Se       4     0.339383    0.624100    0.129997 1
#END

