data_from_pyxtal

_symmetry_space_group_name_H-M 'P2/m'
_symmetry_Int_Tables_number                   10
_symmetry_cell_setting                monoclinic
_cell_length_a            4.253200
_cell_length_b            4.391700
_cell_length_c            4.265100
_cell_angle_alpha        90.000000
_cell_angle_beta         96.420000
_cell_angle_gamma        90.000000
_cell_volume             79.167263

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 '-x, -y, -z'
4 'x, -y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
H      H        2     0.998851    0.500000    0.222959 1
Li     Li       1     0.000000    0.000000    0.500000 1
O      O        1     0.000000    0.500000    0.000000 1
I      I        1     0.500000    0.000000    0.500000 1
#END

