data_from_pyxtal

_symmetry_space_group_name_H-M 'P2'
_symmetry_Int_Tables_number                    3
_symmetry_cell_setting                monoclinic
_cell_length_a            6.931300
_cell_length_b            6.959300
_cell_length_c            7.030200
_cell_angle_alpha        90.000000
_cell_angle_beta         90.770000
_cell_angle_gamma        90.000000
_cell_volume            339.085107

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
S      S        1     0.000000    0.241731    0.000000 1
Cu     Cu       2     0.806193    0.441940    0.174677 1
Cu     Cu       2     0.810914    0.420290    0.803925 1
Cu     Cu       2     0.045439    0.827692    0.782550 1
Te     Te       2     0.492857    0.260004    0.699978 1
Te     Te       1     0.000000    0.039737    0.500000 1
Te     Te       2     0.289145    0.754537    0.036329 1
Te     Te       1     0.000000    0.540822    0.500000 1
Ba     Ba       1     0.500000    0.768784    0.500000 1
