data_from_pyxtal

_symmetry_space_group_name_H-M 'P21'
_symmetry_Int_Tables_number                    4
_symmetry_cell_setting                monoclinic
_cell_length_a            4.675800
_cell_length_b            7.064200
_cell_length_c            5.525600
_cell_angle_alpha        90.000000
_cell_angle_beta         90.060000
_cell_angle_gamma        90.000000
_cell_volume            182.514813

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
B      B        2     0.910365    0.405905    0.133574 1
Ni     Ni       2     0.339774    0.121721    0.727202 1
Ni     Ni       2     0.331608    0.796302    0.596252 1
Ni     Ni       2     0.133552    0.451497    0.446271 1
Ni     Ni       2     0.332279    0.356699    0.061810 1
Ni     Ni       2     0.990712    0.092024    0.157791 1
Ni     Ni       2     0.151960    0.757937    0.186097 1
Ga     Ga       2     0.465239    0.017915    0.273167 1
