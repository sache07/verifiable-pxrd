data_from_pyxtal

_symmetry_space_group_name_H-M 'P2/c'
_symmetry_Int_Tables_number                   13
_symmetry_cell_setting                monoclinic
_cell_length_a            8.778300
_cell_length_b            5.061900
_cell_length_c            5.672700
_cell_angle_alpha        90.000000
_cell_angle_beta         93.410000
_cell_angle_gamma        90.000000
_cell_volume            251.619433

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z+1/2'
3 '-x, -y, -z'
4 'x, -y, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Pd     Pd       4     0.136155    0.613139    0.358076 1
Pd     Pd       4     0.616834    0.360343    0.913476 1
Pd     Pd       4     0.881119    0.115958    0.088741 1
Pd     Pd       4     0.634967    0.861622    0.872596 1
