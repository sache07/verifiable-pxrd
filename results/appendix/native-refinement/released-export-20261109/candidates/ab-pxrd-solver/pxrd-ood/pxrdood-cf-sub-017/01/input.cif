data_from_pyxtal

_symmetry_space_group_name_H-M 'P21'
_symmetry_Int_Tables_number                    4
_symmetry_cell_setting                monoclinic
_cell_length_a            3.663400
_cell_length_b           12.454100
_cell_length_c            6.254136
_cell_angle_alpha        90.000000
_cell_angle_beta        106.970401
_cell_angle_gamma        90.000000
_cell_volume            272.915894

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
S      S        2     0.543941    0.665431    0.086028 1
S      S        2     0.760207    0.273399    0.525728 1
S      S        2     0.040234    0.421250    0.086821 1
S      S        2     0.761871    0.526310    0.526032 1
Y      Y        2     0.887401    0.708722    0.771084 1
Y      Y        2     0.628913    0.895621    0.249738 1
Re     Re       2     0.151911    0.592601    0.303730 1
