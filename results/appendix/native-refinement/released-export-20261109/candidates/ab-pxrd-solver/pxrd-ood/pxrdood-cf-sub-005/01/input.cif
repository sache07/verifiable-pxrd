data_from_pyxtal

_symmetry_space_group_name_H-M 'C2/m'
_symmetry_Int_Tables_number                   12
_symmetry_cell_setting                monoclinic
_cell_length_a            6.668600
_cell_length_b            3.853000
_cell_length_c            7.613203
_cell_angle_alpha        90.000000
_cell_angle_beta        107.054445
_cell_angle_gamma        90.000000
_cell_volume            187.012672

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 '-x, -y, -z'
4 'x, -y, z'
5 'x+1/2, y+1/2, z'
6 '-x+1/2, y+1/2, -z'
7 '-x+1/2, -y+1/2, -z'
8 'x+1/2, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
S      S        4     0.446590    0.000000    0.308479 1
Ni     Ni       2     0.000000    0.000000    0.500000 1
Hg     Hg       2     0.000000    0.500000    0.000000 1
#END

