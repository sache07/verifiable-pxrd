data_from_pyxtal

_symmetry_space_group_name_H-M 'I212121'
_symmetry_Int_Tables_number                   24
_symmetry_cell_setting              orthorhombic
_cell_length_a            8.486541
_cell_length_b            8.497662
_cell_length_c            8.506977
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            613.487107

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y, z+1/2'
3 '-x, y+1/2, -z+1/2'
4 'x+1/2, -y+1/2, -z'
5 'x+1/2, y+1/2, z+1/2'
6 '-x+1, -y+1/2, z+1'
7 '-x+1/2, y+1, -z+1'
8 'x+1, -y+1, -z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
S      S        8     0.422818    0.569177    0.932084 1
S      S        8     0.175580    0.820528    0.680815 1
Nd     Nd       4     0.250000    0.879675    0.000000 1
Dy     Dy       4     0.630117    0.000000    0.250000 1
Yb     Yb       4     0.000000    0.250000    0.131423 1
#END

