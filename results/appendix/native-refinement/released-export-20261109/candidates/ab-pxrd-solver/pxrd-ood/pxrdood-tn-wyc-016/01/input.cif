data_from_pyxtal

_symmetry_space_group_name_H-M 'C2'
_symmetry_Int_Tables_number                    5
_symmetry_cell_setting                monoclinic
_cell_length_a            6.441200
_cell_length_b            8.666200
_cell_length_c           12.414400
_cell_angle_alpha        90.000000
_cell_angle_beta        104.490000
_cell_angle_gamma        90.000000
_cell_volume            670.938037

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 'x+1/2, y+1/2, z'
4 '-x+1/2, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        4     0.810509    0.085290    0.495921 1
O      O        4     0.039473    0.971045    0.865707 1
O      O        4     0.315527    0.811247    0.730685 1
O      O        4     0.593883    0.200743    0.263167 1
O      O        4     0.764086    0.179709    0.956376 1
Ti     Ti       4     0.639669    0.280781    0.817131 1
Rb     Rb       2     0.000000    0.773133    0.500000 1
La     La       4     0.448016    0.619261    0.347585 1
Ta     Ta       2     0.000000    0.055714    0.000000 1
