data_from_pyxtal

_symmetry_space_group_name_H-M 'C2/c'
_symmetry_Int_Tables_number                   15
_symmetry_cell_setting                monoclinic
_cell_length_a           12.822100
_cell_length_b            3.669000
_cell_length_c            9.755800
_cell_angle_alpha        90.000000
_cell_angle_beta        115.090000
_cell_angle_gamma        90.000000
_cell_volume            415.648970

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z+1/2'
3 '-x, -y, -z'
4 'x, -y, z+1/2'
5 'x+1/2, y+1/2, z'
6 '-x+1/2, y+1/2, -z+1/2'
7 '-x+1/2, -y+1/2, -z'
8 'x+1/2, -y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        8     0.189064    0.007624    0.920412 1
F      F        8     0.322514    0.599252    0.834086 1
S      S        8     0.997550    0.416867    0.352106 1
V      V        8     0.318481    0.945326    0.649016 1
#END

