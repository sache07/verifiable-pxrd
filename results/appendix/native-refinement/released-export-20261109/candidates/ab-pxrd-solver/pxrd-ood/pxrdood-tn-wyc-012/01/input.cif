data_from_pyxtal

_symmetry_space_group_name_H-M 'Pmmm'
_symmetry_Int_Tables_number                   47
_symmetry_cell_setting              orthorhombic
_cell_length_a            2.458232
_cell_length_b            8.154402
_cell_length_c           11.531691
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            231.157534

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-x, y, -z'
4 'x, -y, -z'
5 '-x, -y, -z'
6 'x, y, -z'
7 'x, -y, z'
8 '-x, y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        4     0.500000    0.921636    0.222163 1
O      O        2     0.000000    0.308681    0.000000 1
O      O        2     0.000000    0.195444    0.500000 1
Rb     Rb       1     0.000000    0.000000    0.000000 1
In     In       1     0.000000    0.500000    0.500000 1
W      W        1     0.500000    0.000000    0.500000 1
W      W        1     0.500000    0.500000    0.000000 1
