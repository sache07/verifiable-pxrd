data_from_pyxtal

_symmetry_space_group_name_H-M 'P2/c'
_symmetry_Int_Tables_number                   13
_symmetry_cell_setting                monoclinic
_cell_length_a           12.281900
_cell_length_b            6.501400
_cell_length_c            6.586900
_cell_angle_alpha        90.000000
_cell_angle_beta        102.630000
_cell_angle_gamma        90.000000
_cell_volume            513.233977

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z+1/2'
3 '-x, -y, -z'
4 'x, -y, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Sb     Sb       4     0.840958    0.732262    0.923704 1
Sb     Sb       2     0.500000    0.000000    0.000000 1
Nd     Nd       4     0.892880    0.770319    0.454774 1
Nd     Nd       4     0.635853    0.578701    0.122228 1
