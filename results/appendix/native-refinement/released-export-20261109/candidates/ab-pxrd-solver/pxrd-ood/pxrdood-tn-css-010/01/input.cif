data_from_pyxtal

_symmetry_space_group_name_H-M 'P-3m1'
_symmetry_Int_Tables_number                  164
_symmetry_cell_setting                  trigonal
_cell_length_a            3.868371
_cell_length_b            3.868371
_cell_length_c           11.477823
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            148.746401

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'
4 'y, x, -z'
5 'x-y, -y, -z'
6 '-x, -x+y, -z'
7 '-x, -y, -z'
8 'y, -x+y, -z'
9 'x-y, x, -z'
10 '-y, -x, z'
11 '-x+y, y, z'
12 'x, x-y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        2     0.333333    0.666667    0.588407 1
O      O        2     0.333333    0.666667    0.249104 1
Br     Br       1     0.000000    0.000000    0.000000 1
Sm     Sm       1     0.000000    0.000000    0.500000 1
Bi     Bi       2     0.333333    0.666667    0.783662 1
#END

