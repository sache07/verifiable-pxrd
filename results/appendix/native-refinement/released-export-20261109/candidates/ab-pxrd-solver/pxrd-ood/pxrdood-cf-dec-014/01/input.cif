data_from_pyxtal

_symmetry_space_group_name_H-M 'P21'
_symmetry_Int_Tables_number                    4
_symmetry_cell_setting                monoclinic
_cell_length_a            6.783900
_cell_length_b            6.682500
_cell_length_c            6.865500
_cell_angle_alpha        90.000000
_cell_angle_beta        113.810000
_cell_angle_gamma        90.000000
_cell_volume            284.746954

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Fe     Fe       2     0.350963    0.068327    0.068355 1
Sb     Sb       2     0.340289    0.217675    0.414308 1
Sb     Sb       2     0.213754    0.754277    0.183662 1
Te     Te       2     0.150921    0.947676    0.649832 1
Te     Te       2     0.699375    0.933976    0.077292 1
Os     Os       2     0.264416    0.578069    0.545027 1
