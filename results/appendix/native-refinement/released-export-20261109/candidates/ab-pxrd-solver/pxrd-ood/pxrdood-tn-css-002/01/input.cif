data_from_pyxtal

_symmetry_space_group_name_H-M 'Cm'
_symmetry_Int_Tables_number                    8
_symmetry_cell_setting                monoclinic
_cell_length_a            6.841400
_cell_length_b            6.609500
_cell_length_c            3.076100
_cell_angle_alpha        90.000000
_cell_angle_beta        116.690000
_cell_angle_gamma        90.000000
_cell_volume            124.275121

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 'x, -y, z'
3 'x+1/2, y+1/2, z'
4 'x+1/2, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        2     0.010451    0.000000    0.078263 1
O      O        2     0.510680    0.000000    0.108892 1
Zn     Zn       2     0.823102    0.000000    0.388844 1
Zn     Zn       2     0.322433    0.000000    0.424001 1
#END

