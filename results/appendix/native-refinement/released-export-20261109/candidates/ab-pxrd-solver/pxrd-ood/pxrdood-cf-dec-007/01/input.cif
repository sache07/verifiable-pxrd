data_from_pyxtal

_symmetry_space_group_name_H-M 'Cc'
_symmetry_Int_Tables_number                    9
_symmetry_cell_setting                monoclinic
_cell_length_a            3.974300
_cell_length_b           20.797900
_cell_length_c            3.983800
_cell_angle_alpha        90.000000
_cell_angle_beta         90.010000
_cell_angle_gamma        90.000000
_cell_volume            329.289326

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 'x, -y, z+1/2'
3 'x+1/2, y+1/2, z'
4 'x+1/2, -y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
N      N        4     0.394826    0.799138    0.616296 1
Ga     Ga       4     0.955081    0.608949    0.128798 1
Sb     Sb       4     0.134745    0.947674    0.130818 1
La     La       4     0.848681    0.807855    0.124088 1
#END

