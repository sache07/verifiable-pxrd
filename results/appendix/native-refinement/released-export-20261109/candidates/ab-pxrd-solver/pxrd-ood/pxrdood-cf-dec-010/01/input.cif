data_from_pyxtal

_symmetry_space_group_name_H-M 'Cm'
_symmetry_Int_Tables_number                    8
_symmetry_cell_setting                monoclinic
_cell_length_a            3.388100
_cell_length_b            5.869300
_cell_length_c           13.235176
_cell_angle_alpha        90.000000
_cell_angle_beta         90.027419
_cell_angle_gamma        90.000000
_cell_volume            263.191703

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 'x, -y, z'
3 'x+1/2, y+1/2, z'
4 'x+1/2, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
S      S        2     0.544756    0.000000    0.058149 1
S      S        2     0.000633    0.000000    0.532289 1
S      S        2     0.996970    0.000000    0.790026 1
S      S        2     0.540245    0.000000    0.317154 1
Cu     Cu       2     0.048361    0.000000    0.952305 1
Nb     Nb       2     0.041863    0.000000    0.191571 1
Ta     Ta       2     0.493839    0.000000    0.658506 1
