data_from_pyxtal

_symmetry_space_group_name_H-M 'Pmn21'
_symmetry_Int_Tables_number                   31
_symmetry_cell_setting              orthorhombic
_cell_length_a           32.549964
_cell_length_b            3.664371
_cell_length_c            3.683208
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            439.315235

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y, z+1/2'
3 'x+1/2, -y, z+1/2'
4 '-x, y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Si     Si       4     0.081626    0.476192    0.549688 1
Si     Si       2     0.000000    0.211660    0.653714 1
Si     Si       2     0.000000    0.740755    0.653698 1
Hf     Hf       4     0.926724    0.976183    0.051053 1
Au     Au       2     0.000000    0.476168    0.157774 1
