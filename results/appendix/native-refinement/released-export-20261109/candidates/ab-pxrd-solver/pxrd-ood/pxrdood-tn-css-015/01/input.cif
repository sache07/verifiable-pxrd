data_from_pyxtal

_symmetry_space_group_name_H-M 'C2'
_symmetry_Int_Tables_number                    5
_symmetry_cell_setting                monoclinic
_cell_length_a            8.454500
_cell_length_b            4.884700
_cell_length_c            6.460500
_cell_angle_alpha        90.000000
_cell_angle_beta        115.860000
_cell_angle_gamma        90.000000
_cell_volume            240.086705

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 'x+1/2, y+1/2, z'
4 '-x+1/2, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Li     Li       4     0.159047    0.752381    0.688003 1
O      O        4     0.897174    0.218648    0.787290 1
O      O        4     0.130023    0.849129    0.951771 1
F      F        2     0.000000    0.540789    0.500000 1
P      P        2     0.000000    0.036593    0.000000 1
Co     Co       2     0.000000    0.532301    0.000000 1
#END

