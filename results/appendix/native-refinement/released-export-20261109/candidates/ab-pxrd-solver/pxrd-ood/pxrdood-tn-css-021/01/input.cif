data_from_pyxtal

_symmetry_space_group_name_H-M 'C2'
_symmetry_Int_Tables_number                    5
_symmetry_cell_setting                monoclinic
_cell_length_a           12.946100
_cell_length_b           12.936800
_cell_length_c            6.677100
_cell_angle_alpha        90.000000
_cell_angle_beta         90.060000
_cell_angle_gamma        90.000000
_cell_volume           1118.287483

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 'x+1/2, y+1/2, z'
4 '-x+1/2, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
B      B        2     0.000000    0.319463    0.500000 1
B      B        2     0.000000    0.201943    0.000000 1
B      B        2     0.000000    0.944848    0.500000 1
