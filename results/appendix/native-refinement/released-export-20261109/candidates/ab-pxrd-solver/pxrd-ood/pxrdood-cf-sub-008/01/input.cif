data_from_pyxtal

_symmetry_space_group_name_H-M 'Pmm2'
_symmetry_Int_Tables_number                   25
_symmetry_cell_setting              orthorhombic
_cell_length_a            2.899414
_cell_length_b            5.021512
_cell_length_c           12.169107
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            177.175406

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x, -y, z'
4 '-x, y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Li     Li       1     0.500000    0.500000    0.941931 1
S      S        1     0.000000    0.500000    0.792486 1
S      S        1     0.500000    0.000000    0.168321 1
S      S        1     0.000000    0.500000    0.374240 1
S      S        1     0.500000    0.000000    0.496889 1
Nb     Nb       1     0.500000    0.500000    0.220003 1
Nb     Nb       1     0.000000    0.000000    0.339463 1
