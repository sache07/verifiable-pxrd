# Elemental chromium, hexagonal hP4 model refined against pattern.csv
data_Cr_hP4
_audit_creation_method                  'indexed and intensity-matched from powder XRD'
_chemical_formula_structural           Cr
_chemical_formula_sum                  Cr4
_cell_formula_units_Z                  4
_cell_length_a                         4.86059167
_cell_length_b                         4.86059167
_cell_length_c                         2.30466781
_cell_angle_alpha                      90
_cell_angle_beta                       90
_cell_angle_gamma                      120
_cell_volume                           47.15385940
_space_group_name_H-M_alt              'P 6/m m m'
_space_group_IT_number                 191

loop_
 _space_group_symop_id
 _space_group_symop_operation_xyz
  1  'x, y, z'
  2  '-x, -y, -z'
  3  'x-y, x, z'
  4  '-x+y, -x, -z'
  5  '-y, x-y, z'
  6  'y, -x+y, -z'
  7  '-x, -y, z'
  8  'x, y, -z'
  9  '-x+y, -x, z'
 10  'x-y, x, -z'
 11  'y, -x+y, z'
 12  '-y, x-y, -z'
 13  '-y, -x, -z'
 14  'y, x, z'
 15  '-x, -x+y, -z'
 16  'x, x-y, z'
 17  '-x+y, y, -z'
 18  'x-y, -y, z'
 19  'y, x, -z'
 20  '-y, -x, z'
 21  'x, x-y, -z'
 22  '-x, -x+y, z'
 23  'x-y, -y, -z'
 24  '-x+y, y, z'

loop_
 _atom_site_type_symbol
 _atom_site_label
 _atom_site_symmetry_multiplicity
 _atom_site_Wyckoff_symbol
 _atom_site_fract_x
