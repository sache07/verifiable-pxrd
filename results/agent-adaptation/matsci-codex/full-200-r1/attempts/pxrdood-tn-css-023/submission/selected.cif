# NdIr4B4 structure solution from Cu Kalpha1 PXRD
# Symmetry-lowered derivative of the P42/nmc rare-earth-M4B4 topology
data_NdIr4B4_selected
_audit_creation_method              'PXRD indexing and structure-factor refinement'
_symmetry_space_group_name_H-M      'P -1'
_symmetry_space_group_name_Hall     '-P 1'
_symmetry_Int_Tables_number         2
_cell_length_a                      5.25103878
_cell_length_b                      5.03343415
_cell_length_c                      7.58107351
_cell_angle_alpha                   80.37139677
_cell_angle_beta                    89.75434448
_cell_angle_gamma                   90.96892648
_cell_volume                        197.51739559
_cell_formula_units_Z               2
_chemical_formula_structural        'Nd(BIr)4'
_chemical_formula_sum               'B8 Ir8 Nd2'

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
