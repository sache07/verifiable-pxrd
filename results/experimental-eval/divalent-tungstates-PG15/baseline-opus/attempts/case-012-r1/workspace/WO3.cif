# gamma-WO3 (monoclinic room-temperature WO3), Rietveld-refined against inputs/pattern.csv
# Starting model: Loopstra & Boldrini, Acta Cryst. 21 (1966) 158 (COD 2311041), re-expressed
#   in the conventional P2_1/n cell (a' = a+c, b' = b, c' = -a; volume preserved).
# Refined here: lattice parameters, W1 and W2 fractional coordinates, phase scale, microstrain.
# O positions were held at the published (neutron) values; they are not determinable from
#   this lab Cu-Ka pattern for a 24 wt% phase.
######################################################################
data_WO3

# phase info for WO3 follows
_pd_phase_name  WO3
_cell_length_a  7.30333
_cell_length_b  7.53483
_cell_length_c  7.69010
_cell_angle_alpha  90.0000
_cell_angle_beta  90.8150
_cell_angle_gamma  90.0000
_cell_volume  423.139
_symmetry_cell_setting  monoclinic
_symmetry_space_group_name_H-M  "P 21/n"
loop_
    _space_group_symop_id
    _space_group_symop_operation_xyz
     1  x,y,z
     2  1/2-x,1/2+y,1/2-z
     3  -x,-y,-z
     4  1/2+x,1/2-y,1/2+z

# ATOMIC COORDINATES AND DISPLACEMENT PARAMETERS
loop_ 
   _atom_site_label
   _atom_site_type_symbol
   _atom_site_fract_x
   _atom_site_fract_y
   _atom_site_fract_z
   _atom_site_occupancy
   _atom_site_adp_type
   _atom_site_U_iso_or_equiv
   _atom_site_site_symmetry_multiplicity
O1     O    0.72100     0.48700     0.00700     1.0000     Uiso 0.0100     4   
O2     O    0.00700     0.47400     0.78200     1.0000     Uiso 0.0100     4   
W1     W    0.7502(18)  0.0343(11)  0.7122(12)  1.0000     Uiso 0.0040     4   
O3     O    0.70800     0.04300     0.99200     1.0000     Uiso 0.0100     4   
O4     O    0.71200     0.26200     0.71400     1.0000     Uiso 0.0100     4   
O5     O    0.99500     0.04200     0.78900     1.0000     Uiso 0.0100     4   
W2     W    0.7477(18)  0.0255(12)  0.2224(12)  1.0000     Uiso 0.0040     4   
O6     O    0.78900     0.25900     0.27000     1.0000     Uiso 0.0100     4   

loop_  _atom_type_symbol _atom_type_number_in_cell
  O       24
  W       8

# Note that Z affects _cell_formula_sum and _weight
_cell_formula_units_Z  4
_chemical_formula_sum  "O6 W2"
_chemical_formula_weight  463.69
