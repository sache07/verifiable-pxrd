# gamma-WO3 (monoclinic), Rietveld refinement of inputs/pattern.csv (Cu K-alpha).
# Starting model COD 2311041 transformed to the conventional P2_1/n setting.
# Refined here: cell, W1/W2(x,y,z) and one shared Uiso for the O sites.
# W Uiso held at 0.005 A^2 and the O coordinates HELD at the reference
# values - they are not determinable from this pattern (see report.md).
data_WO3

# phase info for WO3 follows
_pd_phase_name  WO3
_cell_length_a  7.30882
_cell_length_b  7.53809
_cell_length_c  7.69444
_cell_angle_alpha  90.0000
_cell_angle_beta  90.7455
_cell_angle_gamma  90.0000
_cell_volume  423.886
_symmetry_cell_setting  monoclinic
_symmetry_space_group_name_H-M  "P 21/n"
loop_
    _space_group_symop_id
    _space_group_symop_operation_xyz
     1  x,y,z
     2  1/2-x,1/2+y,1/2-z
     3  -x,-y,-z
     4  1/2+x,1/2-y,1/2+z

# ATOMIC COORDINATES AND DISPLACEMENT PARAMETERS
