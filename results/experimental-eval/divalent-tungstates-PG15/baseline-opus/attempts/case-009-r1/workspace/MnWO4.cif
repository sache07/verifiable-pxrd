 
######################################################################
data_MnWO4

# Rietveld refinement against Cu K-alpha laboratory PXRD (10-100 deg 2theta)
# GSAS-II 5.7.8; project file final.gpx; profile fit.csv
# Rwp = 4.94 %, Rp = 3.74 %, GOF = 1.43, Rf = 1.66 %, Rf^2 = 3.30 % (145 reflections)
# All Uiso values were HELD FIXED (W 0.004, Mn 0.006, O 0.010 A^2); they correlate
# strongly with the surface-roughness correction and are not determined by this data.

# phase info for MnWO4 follows
_pd_phase_name  MnWO4
_chemical_name_mineral  'huebnerite'
_chemical_name_structure_type  'wolframite'
_cell_length_a  4.83056
_cell_length_b  5.75677
_cell_length_c  4.99611
_cell_angle_alpha  90.0000
_cell_angle_beta  91.2172
_cell_angle_gamma  90.0000
_cell_volume  138.903
_symmetry_cell_setting  monoclinic
_symmetry_space_group_name_H-M  "P 2/c"
loop_
    _space_group_symop_id
    _space_group_symop_operation_xyz
     1  x,y,z
     2  -x,y,1/2-z
     3  -x,-y,-z
     4  x,-y,1/2+z

# ATOMIC COORDINATES AND DISPLACEMENT PARAMETERS
