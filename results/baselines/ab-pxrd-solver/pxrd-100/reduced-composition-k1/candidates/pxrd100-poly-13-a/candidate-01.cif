data_from_pyxtal

_symmetry_space_group_name_H-M 'C2'
_symmetry_Int_Tables_number                    5
_symmetry_cell_setting                monoclinic
_cell_length_a           12.386149
_cell_length_b            7.369600
_cell_length_c            7.201900
_cell_angle_alpha        90.000000
_cell_angle_beta        123.735910
_cell_angle_gamma        90.000000
_cell_volume            546.694910

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 'x+1/2, y+1/2, z'
4 '-x+1/2, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
S      S        4     0.260739    0.513450    0.797717 1
S      S        4     0.211456    0.516388    0.177124 1
S      S        4     0.027705    0.213308    0.763156 1
S      S        4     0.009268    0.781262    0.753581 1
Cr     Cr       4     0.746126    0.262367    0.996287 1
Cr     Cr       2     0.000000    0.616114    0.000000 1
Nb     Nb       2     0.000000    0.020571    0.000000 1
Ag     Ag       4     0.879342    0.466311    0.587992 1
