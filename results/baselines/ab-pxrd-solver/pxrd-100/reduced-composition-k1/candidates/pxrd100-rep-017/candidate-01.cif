data_from_pyxtal

_symmetry_space_group_name_H-M 'C2'
_symmetry_Int_Tables_number                    5
_symmetry_cell_setting                monoclinic
_cell_length_a            5.580400
_cell_length_b           12.345400
_cell_length_c            5.573900
_cell_angle_alpha        90.000000
_cell_angle_beta         90.080000
_cell_angle_gamma        90.000000
_cell_volume            383.998250

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 'x+1/2, y+1/2, z'
4 '-x+1/2, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        4     0.758003    0.038864    0.242963 1
O      O        4     0.241284    0.039078    0.243305 1
Na     Na       2     0.000000    0.637009    0.500000 1
Cl     Cl       2     0.000000    0.787930    0.000000 1
Cl     Cl       2     0.000000    0.303652    0.500000 1
Bi     Bi       2     0.000000    0.450036    0.000000 1
Bi     Bi       2     0.000000    0.133807    0.000000 1
Bi     Bi       2     0.000000    0.948349    0.500000 1
