data_from_pyxtal

_symmetry_space_group_name_H-M 'Cm'
_symmetry_Int_Tables_number                    8
_symmetry_cell_setting                monoclinic
_cell_length_a           11.666500
_cell_length_b            6.803100
_cell_length_c           12.843500
_cell_angle_alpha        90.000000
_cell_angle_beta         92.200000
_cell_angle_gamma        90.000000
_cell_volume           1018.616252

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 'x, -y, z'
3 'x+1/2, y+1/2, z'
4 'x+1/2, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
S      S        4     0.322580    0.255983    0.657653 1
S      S        2     0.518297    0.000000    0.801137 1
S      S        2     0.125846    0.000000    0.534734 1
S      S        4     0.333405    0.171898    0.366496 1
S      S        4     0.632520    0.755373    0.822221 1
Cr     Cr       4     0.734482    0.215374    0.497227 1
Cr     Cr       2     0.191852    0.000000    0.704800 1
Nb     Nb       2     0.672352    0.000000    0.671757 1
Ag     Ag       4     0.495567    0.798308    0.508523 1
