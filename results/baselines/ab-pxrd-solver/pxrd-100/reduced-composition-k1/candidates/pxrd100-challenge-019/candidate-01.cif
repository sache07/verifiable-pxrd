data_from_pyxtal

_symmetry_space_group_name_H-M 'C2'
_symmetry_Int_Tables_number                    5
_symmetry_cell_setting                monoclinic
_cell_length_a            5.043600
_cell_length_b            8.714500
_cell_length_c            4.651800
_cell_angle_alpha        90.000000
_cell_angle_beta         90.710000
_cell_angle_gamma        90.000000
_cell_volume            204.442319

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 'x+1/2, y+1/2, z'
4 '-x+1/2, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Li     Li       4     0.258514    0.887289    0.917686 1
O      O        2     0.000000    0.215146    0.000000 1
F      F        4     0.912355    0.937515    0.739823 1
F      F        4     0.340789    0.081518    0.677609 1
F      F        2     0.000000    0.343967    0.500000 1
Nb     Nb       2     0.000000    0.128245    0.500000 1
#END

