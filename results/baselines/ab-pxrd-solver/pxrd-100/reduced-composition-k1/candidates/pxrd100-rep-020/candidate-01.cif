data_from_pyxtal

_symmetry_space_group_name_H-M 'C2'
_symmetry_Int_Tables_number                    5
_symmetry_cell_setting                monoclinic
_cell_length_a            6.099400
_cell_length_b            6.097100
_cell_length_c            8.573700
_cell_angle_alpha        90.000000
_cell_angle_beta        110.810000
_cell_angle_gamma        90.000000
_cell_volume            298.044113

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 'x+1/2, y+1/2, z'
4 '-x+1/2, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Si     Si       4     0.386273    0.527320    0.758194 1
Sc     Sc       4     0.749003    0.277202    0.999728 1
Pr     Pr       4     0.830960    0.528812    0.645928 1
#END

