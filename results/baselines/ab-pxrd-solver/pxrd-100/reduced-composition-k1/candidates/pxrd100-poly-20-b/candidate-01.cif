data_from_pyxtal

_symmetry_space_group_name_H-M 'C2'
_symmetry_Int_Tables_number                    5
_symmetry_cell_setting                monoclinic
_cell_length_a           11.230700
_cell_length_b            6.477600
_cell_length_c            7.188700
_cell_angle_alpha        90.000000
_cell_angle_beta        121.300000
_cell_angle_gamma        90.000000
_cell_volume            446.850712

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 'x+1/2, y+1/2, z'
4 '-x+1/2, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Mg     Mg       2     0.000000    0.000375    0.000000 1
Yb     Yb       4     0.833925    0.494047    0.000274 1
Yb     Yb       4     0.667364    0.173490    0.498528 1
Yb     Yb       2     0.000000    0.164549    0.500000 1
#END

