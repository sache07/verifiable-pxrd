data_from_pyxtal

_symmetry_space_group_name_H-M 'P422'
_symmetry_Int_Tables_number                   89
_symmetry_cell_setting                tetragonal
_cell_length_a            8.258581
_cell_length_b            8.258581
_cell_length_c            6.964730
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            475.023577

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-y, x, z'
4 'y, -x, z'
5 '-x, y, -z'
6 'x, -y, -z'
7 'y, x, -z'
8 '-y, -x, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Se     Se       8     0.328457    0.168999    0.248613 1
In     In       2     0.500000    0.000000    0.500000 1
In     In       2     0.500000    0.000000    0.000000 1
In     In       1     0.000000    0.000000    0.000000 1
Tl     Tl       1     0.500000    0.500000    0.000000 1
Tl     Tl       1     0.000000    0.000000    0.500000 1
Tl     Tl       1     0.500000    0.500000    0.500000 1
#END

