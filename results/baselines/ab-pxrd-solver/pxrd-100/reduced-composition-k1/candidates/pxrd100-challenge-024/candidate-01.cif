data_from_pyxtal

_symmetry_space_group_name_H-M 'P42/mnm'
_symmetry_Int_Tables_number                  136
_symmetry_cell_setting                tetragonal
_cell_length_a            9.358061
_cell_length_b            9.358061
_cell_length_c            3.862402
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            338.243343

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-y+1/2, x+1/2, z+1/2'
4 'y+1/2, -x+1/2, z+1/2'
5 '-x+1/2, y+1/2, -z+1/2'
6 'x+1/2, -y+1/2, -z+1/2'
7 'y, x, -z'
8 '-y, -x, -z'
9 '-x, -y, -z'
10 'x, y, -z'
11 'y+1/2, -x+1/2, -z+1/2'
12 '-y+1/2, x+1/2, -z+1/2'
13 'x+1/2, -y+1/2, z+1/2'
14 '-x+1/2, y+1/2, z+1/2'
15 '-y, -x, z'
16 'y, x, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        4     0.113244    0.113244    0.000000 1
F      F        8     0.387669    0.829400    0.000000 1
F      F        4     0.596260    0.596260    0.000000 1
Nb     Nb       4     0.630331   -0.630331    0.000000 1
#END

