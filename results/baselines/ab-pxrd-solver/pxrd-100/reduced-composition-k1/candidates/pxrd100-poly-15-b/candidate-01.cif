data_from_pyxtal

_symmetry_space_group_name_H-M 'P2221'
_symmetry_Int_Tables_number                   17
_symmetry_cell_setting              orthorhombic
_cell_length_a            6.473034
_cell_length_b            6.966801
_cell_length_c            6.970239
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            314.332283

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z+1/2'
3 '-x, y, -z+1/2'
4 'x, -y, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        4     0.750238    0.829322    0.468282 1
O      O        2     0.000000    0.050032    0.250000 1
O      O        2     0.500000    0.050483    0.250000 1
Si     Si       4     0.750226    0.969462    0.665948 1
#END

