data_from_pyxtal

_symmetry_space_group_name_H-M 'P212121'
_symmetry_Int_Tables_number                   19
_symmetry_cell_setting              orthorhombic
_cell_length_a            4.786829
_cell_length_b            6.763618
_cell_length_c            6.768001
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            219.122732

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y, z+1/2'
3 '-x, y+1/2, -z+1/2'
4 'x+1/2, -y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Si     Si       4     0.561664    0.522233    0.885193 1
Si     Si       4     0.619932    0.142317    0.233892 1
Tc     Tc       4     0.786036    0.810315    0.373827 1
Tc     Tc       4     0.039214    0.642905    0.002955 1
