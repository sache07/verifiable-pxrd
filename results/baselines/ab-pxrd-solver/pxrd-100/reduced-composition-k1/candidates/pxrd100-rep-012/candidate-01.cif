data_from_pyxtal

_symmetry_space_group_name_H-M 'C2/c'
_symmetry_Int_Tables_number                   15
_symmetry_cell_setting                monoclinic
_cell_length_a           17.086030
_cell_length_b            6.783100
_cell_length_c            7.416700
_cell_angle_alpha        90.000000
_cell_angle_beta         96.481087
_cell_angle_gamma        90.000000
_cell_volume            854.074366

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z+1/2'
3 '-x, -y, -z'
4 'x, -y, z+1/2'
5 'x+1/2, y+1/2, z'
6 '-x+1/2, y+1/2, -z+1/2'
7 '-x+1/2, -y+1/2, -z'
8 'x+1/2, -y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
La     La       8     0.787268    0.418312    0.185286 1
La     La       8     0.592719    0.407585    0.413036 1
La     La       4     0.000000    0.435169    0.250000 1
Ir     Ir       8     0.889439    0.704487    0.418086 1
