data_from_pyxtal

_symmetry_space_group_name_H-M 'Fdd2'
_symmetry_Int_Tables_number                   43
_symmetry_cell_setting              orthorhombic
_cell_length_a            9.430345
_cell_length_b            9.434388
_cell_length_c            6.199176
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            551.537798

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x+1/4, -y+1/4, z+1/4'
4 '-x+1/4, y+1/4, z+1/4'
5 'x, y+1/2, z+1/2'
6 '-x, -y+1/2, z+1/2'
7 'x+1/4, -y+3/4, z+3/4'
8 '-x+1/4, y+3/4, z+3/4'
9 'x+1/2, y, z+1/2'
10 '-x+1/2, -y, z+1/2'
11 'x+3/4, -y+1/4, z+3/4'
12 '-x+3/4, y+1/4, z+3/4'
13 'x+1/2, y+1/2, z'
14 '-x+1/2, -y+1/2, z'
15 'x+3/4, -y+3/4, z+1/4'
16 '-x+3/4, y+3/4, z+1/4'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Li     Li       8     0.000000    0.000000    0.737850 1
F      F       16     0.347452    0.352479    0.734443 1
F      F       16     0.340988    0.356640    0.265020 1
V      V        8     0.000000    0.000000    0.263223 1
#END

