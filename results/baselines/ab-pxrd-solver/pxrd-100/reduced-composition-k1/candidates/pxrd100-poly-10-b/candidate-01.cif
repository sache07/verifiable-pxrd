data_from_pyxtal

_symmetry_space_group_name_H-M 'C2/m'
_symmetry_Int_Tables_number                   12
_symmetry_cell_setting                monoclinic
_cell_length_a            9.981100
_cell_length_b            3.959800
_cell_length_c           10.150700
_cell_angle_alpha        90.000000
_cell_angle_beta         90.110000
_cell_angle_gamma        90.000000
_cell_volume            401.186999

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 '-x, -y, -z'
4 'x, -y, z'
5 'x+1/2, y+1/2, z'
6 '-x+1/2, y+1/2, -z'
7 '-x+1/2, -y+1/2, -z'
8 'x+1/2, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Li     Li       4     0.895596    0.000000    0.413852 1
O      O        4     0.303374    0.000000    0.075198 1
O      O        4     0.043112    0.000000    0.122250 1
F      F        4     0.262406    0.000000    0.761330 1
F      F        4     0.918074    0.000000    0.601459 1
F      F        4     0.652096    0.000000    0.635687 1
V      V        4     0.138785    0.000000    0.948292 1
V      V        4     0.806568    0.000000    0.758688 1
