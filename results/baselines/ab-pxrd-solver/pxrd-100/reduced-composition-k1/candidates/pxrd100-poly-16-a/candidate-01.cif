data_from_pyxtal

_symmetry_space_group_name_H-M 'Cc'
_symmetry_Int_Tables_number                    9
_symmetry_cell_setting                monoclinic
_cell_length_a           14.056100
_cell_length_b            3.485300
_cell_length_c           11.911700
_cell_angle_alpha        90.000000
_cell_angle_beta        114.070000
_cell_angle_gamma        90.000000
_cell_volume            532.809907

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 'x, -y, z+1/2'
3 'x+1/2, y+1/2, z'
4 'x+1/2, -y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
S      S        4     0.850959    0.530028    0.384242 1
S      S        4     0.053713    0.007300    0.400659 1
S      S        4     0.065558    0.477556    0.159554 1
S      S        4     0.843062    0.000727    0.636996 1
Ti     Ti       4     0.955576    0.966072    0.030745 1
Cr     Cr       4     0.951778    0.502954    0.265053 1
Ag     Ag       4     0.707925    0.091282    0.395479 1
