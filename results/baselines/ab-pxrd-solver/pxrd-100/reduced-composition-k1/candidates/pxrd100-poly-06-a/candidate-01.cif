data_from_pyxtal

_symmetry_space_group_name_H-M 'P21'
_symmetry_Int_Tables_number                    4
_symmetry_cell_setting                monoclinic
_cell_length_a            4.958200
_cell_length_b           29.493000
_cell_length_c            5.054700
_cell_angle_alpha        90.000000
_cell_angle_beta        108.920000
_cell_angle_gamma        90.000000
_cell_volume            699.224707

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Li     Li       2     0.485629    0.338091    0.616758 1
O      O        2     0.369215    0.278326    0.743619 1
O      O        2     0.505560    0.397701    0.551669 1
O      O        2     0.501506    0.978260    0.951853 1
O      O        2     0.364783    0.775579    0.250296 1
Ni     Ni       2     0.498032    0.942708    0.678741 1
Ni     Ni       2     0.496084    0.944507    0.231157 1
