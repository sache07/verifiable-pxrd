data_from_pyxtal

_symmetry_space_group_name_H-M 'P21/m'
_symmetry_Int_Tables_number                   11
_symmetry_cell_setting                monoclinic
_cell_length_a            9.740600
_cell_length_b            3.841500
_cell_length_c            9.781179
_cell_angle_alpha        90.000000
_cell_angle_beta        119.551140
_cell_angle_gamma        90.000000
_cell_volume            318.386756

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z'
3 '-x, -y, -z'
4 'x, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        2     0.025140    0.250000    0.896184 1
F      F        2     0.398080    0.250000    0.982306 1
F      F        2     0.262635    0.250000    0.242404 1
F      F        2     0.768127    0.250000    0.576778 1
F      F        2     0.516243    0.250000    0.757426 1
F      F        2     0.793879    0.250000    0.129082 1
S      S        2     0.144823    0.250000    0.632490 1
Nd     Nd       2     0.623854    0.250000    0.221326 1
Nd     Nd       2     0.805187    0.250000    0.910293 1
Nd     Nd       2     0.059945    0.250000    0.321767 1
