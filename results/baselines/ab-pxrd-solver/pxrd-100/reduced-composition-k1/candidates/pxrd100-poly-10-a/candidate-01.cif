data_from_pyxtal

_symmetry_space_group_name_H-M 'Cc'
_symmetry_Int_Tables_number                    9
_symmetry_cell_setting                monoclinic
_cell_length_a           10.723000
_cell_length_b            5.144500
_cell_length_c            7.142500
_cell_angle_alpha        90.000000
_cell_angle_beta        111.170000
_cell_angle_gamma        90.000000
_cell_volume            367.421555

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 'x, -y, z+1/2'
3 'x+1/2, y+1/2, z'
4 'x+1/2, -y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Li     Li       4     0.757453    0.006915    0.053903 1
O      O        4     0.602959    0.676116    0.059798 1
O      O        4     0.520709    0.839274    0.345654 1
F      F        4     0.800819    0.646566    0.463046 1
F      F        4     0.685164    0.829320    0.746660 1
F      F        4     0.928101    0.169026    0.651609 1
V      V        4     0.608089    0.507396    0.315886 1
V      V        4     0.996706    0.489289    0.077731 1
