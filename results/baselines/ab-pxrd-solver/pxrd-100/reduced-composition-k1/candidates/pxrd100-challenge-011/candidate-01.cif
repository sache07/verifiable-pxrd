data_from_pyxtal

_symmetry_space_group_name_H-M 'P21/c'
_symmetry_Int_Tables_number                   14
_symmetry_cell_setting                monoclinic
_cell_length_a            6.129500
_cell_length_b           30.091000
_cell_length_c            5.170900
_cell_angle_alpha        90.000000
_cell_angle_beta        110.520000
_cell_angle_gamma        90.000000
_cell_volume            893.220588

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z+1/2'
3 '-x, -y, -z'
4 'x, -y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        4     0.891446    0.883938    0.985669 1
O      O        4     0.755501    0.962727    0.403246 1
O      O        4     0.194237    0.540151    0.222081 1
Ca     Ca       4     0.059537    0.097788    0.437930 1
Ca     Ca       2     0.500000    0.000000    0.000000 1
Co     Co       2     0.000000    0.000000    0.500000 1
