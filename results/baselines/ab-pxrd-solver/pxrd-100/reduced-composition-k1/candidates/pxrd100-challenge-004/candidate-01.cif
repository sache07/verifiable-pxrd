data_from_pyxtal

_symmetry_space_group_name_H-M 'C2/m'
_symmetry_Int_Tables_number                   12
_symmetry_cell_setting                monoclinic
_cell_length_a           10.029207
_cell_length_b            9.207400
_cell_length_c            5.424200
_cell_angle_alpha        90.000000
_cell_angle_beta        107.282050
_cell_angle_gamma        90.000000
_cell_volume            478.273407

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 '-x, -y, -z'
4 'x, -y, z'
5 'x+1/2, y+1/2, z'
6 '-x+1/2, y+1/2, -z'
7 '-x+1/2, -y+1/2, -z'
8 'x+1/2, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        8     0.855308    0.693997    0.031762 1
O      O        8     0.877238    0.160205    0.645074 1
O      O        4     0.135138    0.000000    0.927861 1
O      O        4     0.332335    0.000000    0.314022 1
Na     Na       4     0.000000    0.675145    0.500000 1
Si     Si       8     0.291932    0.359950    0.861865 1
Sc     Sc       2     0.000000    0.500000    0.000000 1
In     In       2     0.000000    0.000000    0.500000 1
