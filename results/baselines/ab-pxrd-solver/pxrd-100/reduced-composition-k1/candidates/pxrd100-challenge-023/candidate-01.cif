data_from_pyxtal

_symmetry_space_group_name_H-M 'P21/c'
_symmetry_Int_Tables_number                   14
_symmetry_cell_setting                monoclinic
_cell_length_a            4.623100
_cell_length_b            5.988400
_cell_length_c            9.084303
_cell_angle_alpha        90.000000
_cell_angle_beta        117.838920
_cell_angle_gamma        90.000000
_cell_volume            222.391216

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z+1/2'
3 '-x, -y, -z'
4 'x, -y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Li     Li       2     0.500000    0.000000    0.000000 1
B      B        4     0.259093    0.658715    0.167283 1
O      O        4     0.728818    0.203947    0.482888 1
O      O        4     0.508728    0.921608    0.807446 1
O      O        4     0.014097    0.238812    0.829511 1
Bi     Bi       2     0.000000    0.000000    0.000000 1
#END

