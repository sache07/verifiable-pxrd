data_from_pyxtal

_symmetry_space_group_name_H-M 'P21/c'
_symmetry_Int_Tables_number                   14
_symmetry_cell_setting                monoclinic
_cell_length_a            2.473100
_cell_length_b           23.848500
_cell_length_c            5.055100
_cell_angle_alpha        90.000000
_cell_angle_beta        100.290000
_cell_angle_gamma        90.000000
_cell_volume            293.353059

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z+1/2'
3 '-x, -y, -z'
4 'x, -y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Li     Li       2     0.000000    0.000000    0.500000 1
O      O        4     0.699894    0.394214    0.643377 1
O      O        4     0.445085    0.542937    0.769133 1
Ni     Ni       4     0.126178    0.423928    0.436787 1
#END

