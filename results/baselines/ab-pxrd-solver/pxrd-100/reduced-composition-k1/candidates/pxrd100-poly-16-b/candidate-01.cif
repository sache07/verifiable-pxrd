data_from_pyxtal

_symmetry_space_group_name_H-M 'Cm'
_symmetry_Int_Tables_number                    8
_symmetry_cell_setting                monoclinic
_cell_length_a           11.877700
_cell_length_b            6.980800
_cell_length_c            6.541800
_cell_angle_alpha        90.000000
_cell_angle_beta         91.470000
_cell_angle_gamma        90.000000
_cell_volume            542.240382

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 'x, -y, z'
3 'x+1/2, y+1/2, z'
4 'x+1/2, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
S      S        4     0.639363    0.782728    0.899702 1
S      S        4     0.310918    0.722508    0.249888 1
S      S        4     0.584068    0.254258    0.433439 1
S      S        4     0.364373    0.149479    0.667296 1
Ti     Ti       2     0.661110    0.000000    0.181105 1
Ti     Ti       2     0.234707    0.000000    0.427084 1
Cr     Cr       2     0.945356    0.000000    0.376840 1
Cr     Cr       2     0.552462    0.000000    0.682116 1
Ag     Ag       4     0.449915    0.745237    0.999436 1
