data_from_pyxtal

_symmetry_space_group_name_H-M 'Cc'
_symmetry_Int_Tables_number                    9
_symmetry_cell_setting                monoclinic
_cell_length_a            8.945800
_cell_length_b            5.119700
_cell_length_c            6.182400
_cell_angle_alpha        90.000000
_cell_angle_beta        118.770000
_cell_angle_gamma        90.000000
_cell_volume            248.200044

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 'x, -y, z+1/2'
3 'x+1/2, y+1/2, z'
4 'x+1/2, -y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Li     Li       4     0.706138    0.412806    0.032379 1
B      B        4     0.349238    0.407522    0.947282 1
O      O        4     0.198588    0.456700    0.409457 1
O      O        4     0.839902    0.363098    0.425864 1
O      O        4     0.990648    0.957669    0.484416 1
Zn     Zn       4     0.040485    0.588911    0.533935 1
#END

