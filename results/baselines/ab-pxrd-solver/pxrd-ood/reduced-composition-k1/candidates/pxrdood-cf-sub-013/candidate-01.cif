data_from_pyxtal

_symmetry_space_group_name_H-M 'Pma2'
_symmetry_Int_Tables_number                   28
_symmetry_cell_setting              orthorhombic
_cell_length_a            6.204067
_cell_length_b           10.743158
_cell_length_c            3.780387
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            251.967594

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x+1/2, -y, z'
4 '-x+1/2, y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
C      C        2     0.250000    0.876998    0.651305 1
C      C        2     0.250000    0.793811    0.891279 1
Cd     Cd       2     0.250000    0.427233    0.008129 1
Cd     Cd       2     0.250000    0.233086    0.569824 1
Yb     Yb       2     0.250000    0.010688    0.142732 1
Yb     Yb       2     0.250000    0.654630    0.403398 1
