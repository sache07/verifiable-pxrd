data_from_pyxtal

_symmetry_space_group_name_H-M 'Iba2'
_symmetry_Int_Tables_number                   45
_symmetry_cell_setting              orthorhombic
_cell_length_a            5.703932
_cell_length_b            9.744756
_cell_length_c            9.988241
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            555.180707

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x+1/2, -y+1/2, z'
4 '-x+1/2, y+1/2, z'
5 'x+1/2, y+1/2, z+1/2'
6 '-x+1/2, -y+1/2, z+1/2'
7 'x+1, -y+1, z+1/2'
8 '-x+1, y+1, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
B      B        8     0.497666    0.842924    0.044975 1
B      B        8     0.005477    0.154713    0.039607 1
Y      Y        4     0.000000    0.000000    0.271343 1
Rh     Rh       8     0.242956    0.500799    0.004811 1
Rh     Rh       8     0.756286    0.248290    0.163825 1
