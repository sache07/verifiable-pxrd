data_from_pyxtal

_symmetry_space_group_name_H-M 'C2/m'
_symmetry_Int_Tables_number                   12
_symmetry_cell_setting                monoclinic
_cell_length_a            5.234200
_cell_length_b            9.042100
_cell_length_c            9.341333
_cell_angle_alpha        90.000000
_cell_angle_beta         90.030327
_cell_angle_gamma        90.000000
_cell_volume            442.108034

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 '-x, -y, -z'
4 'x, -y, z'
5 'x+1/2, y+1/2, z'
6 '-x+1/2, y+1/2, -z'
7 '-x+1/2, -y+1/2, -z'
8 'x+1/2, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        8     0.159924    0.147771    0.381863 1
O      O        8     0.751110    0.137917    0.027563 1
O      O        4     0.261179    0.000000    0.609186 1
O      O        4     0.981618    0.000000    0.823272 1
O      O        4     0.485538    0.000000    0.177254 1
P      P        4     0.020729    0.000000    0.343858 1
P      P        4     0.737109    0.000000    0.926788 1
Mn     Mn       4     0.000000    0.332275    0.500000 1
