data_from_pyxtal

_symmetry_space_group_name_H-M 'P21'
_symmetry_Int_Tables_number                    4
_symmetry_cell_setting                monoclinic
_cell_length_a            3.620800
_cell_length_b            9.706400
_cell_length_c            8.043576
_cell_angle_alpha        90.000000
_cell_angle_beta         90.078613
_cell_angle_gamma        90.000000
_cell_volume            282.690684

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Lu     Lu       2     0.232658    0.063171    0.333288 1
Lu     Lu       2     0.209112    0.229824    0.726510 1
Lu     Lu       2     0.690982    0.011488    0.990765 1
Lu     Lu       2     0.290211    0.416735    0.393098 1
Lu     Lu       2     0.794365    0.278781    0.106962 1
#END

