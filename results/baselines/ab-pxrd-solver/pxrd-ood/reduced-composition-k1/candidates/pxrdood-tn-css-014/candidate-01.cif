data_from_pyxtal

_symmetry_space_group_name_H-M 'Imm2'
_symmetry_Int_Tables_number                   44
_symmetry_cell_setting              orthorhombic
_cell_length_a            7.067768
_cell_length_b            7.073540
_cell_length_c           10.581654
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            529.020633

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x, -y, z'
4 '-x, y, z'
5 'x+1/2, y+1/2, z+1/2'
6 '-x+1/2, -y+1/2, z+1/2'
7 'x+1/2, -y+1/2, z+1/2'
8 '-x+1/2, y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
S      S        8     0.724524    0.221999    0.397252 1
S      S        4     0.000000    0.247733    0.637451 1
Nb     Nb       2     0.000000    0.500000    0.791541 1
Nb     Nb       2     0.000000    0.000000    0.795883 1
Nb     Nb       2     0.000000    0.000000    0.490107 1
Ag     Ag       2     0.000000    0.500000    0.062567 1
Ag     Ag       2     0.000000    0.000000    0.192526 1
Te     Te       2     0.000000    0.500000    0.303465 1
