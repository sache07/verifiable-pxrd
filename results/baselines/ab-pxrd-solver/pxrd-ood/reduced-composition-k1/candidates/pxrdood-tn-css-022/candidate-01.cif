data_from_pyxtal

_symmetry_space_group_name_H-M 'P2/m'
_symmetry_Int_Tables_number                   10
_symmetry_cell_setting                monoclinic
_cell_length_a            5.884300
_cell_length_b            5.644500
_cell_length_c           10.217980
_cell_angle_alpha        90.000000
_cell_angle_beta         90.818431
_cell_angle_gamma        90.000000
_cell_volume            339.344662

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 '-x, -y, -z'
4 'x, -y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
B      B        2     0.735547    0.000000    0.027651 1
B      B        2     0.639631    0.500000    0.687926 1
O      O        4     0.265623    0.224791    0.972315 1
O      O        4     0.698073    0.714312    0.615415 1
O      O        2     0.238885    0.000000    0.596436 1
O      O        2     0.551892    0.500000    0.807768 1
Al     Al       1     0.000000    0.000000    0.500000 1
Ga     Ga       1     0.500000    0.500000    0.000000 1
Ga     Ga       1     0.500000    0.000000    0.500000 1
Bi     Bi       1     0.000000    0.500000    0.500000 1
