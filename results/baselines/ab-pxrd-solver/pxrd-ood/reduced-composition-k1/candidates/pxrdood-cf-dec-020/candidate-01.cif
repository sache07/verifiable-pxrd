data_from_pyxtal

_symmetry_space_group_name_H-M 'Cm'
_symmetry_Int_Tables_number                    8
_symmetry_cell_setting                monoclinic
_cell_length_a           17.360300
_cell_length_b            4.922000
_cell_length_c            4.920100
_cell_angle_alpha        90.000000
_cell_angle_beta        106.410000
_cell_angle_gamma        90.000000
_cell_volume            403.284212

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 'x, -y, z'
3 'x+1/2, y+1/2, z'
4 'x+1/2, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
F      F        2     0.903549    0.000000    0.717883 1
Cl     Cl       2     0.134044    0.000000    0.050491 1
Cr     Cr       2     0.134366    0.000000    0.550702 1
Rb     Rb       2     0.772633    0.000000    0.238698 1
Rb     Rb       2     0.492062    0.000000    0.850951 1
I      I        2     0.289905    0.000000    0.753333 1
I      I        2     0.979324    0.000000    0.337942 1
#END

