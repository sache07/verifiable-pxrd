data_from_pyxtal

_symmetry_space_group_name_H-M 'P21/m'
_symmetry_Int_Tables_number                   11
_symmetry_cell_setting                monoclinic
_cell_length_a            8.464200
_cell_length_b            8.616400
_cell_length_c            8.554400
_cell_angle_alpha        90.000000
_cell_angle_beta         99.710000
_cell_angle_gamma        90.000000
_cell_volume            614.942691

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z'
3 '-x, -y, -z'
4 'x, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Br     Br       4     0.852016    0.454260    0.833422 1
Br     Br       2     0.991650    0.250000    0.460087 1
Te     Te       4     0.692104    0.561820    0.160581 1
Te     Te       2     0.480471    0.250000    0.372454 1
Pr     Pr       4     0.738548    0.498894    0.507889 1
Pr     Pr       2     0.624150    0.250000    0.973581 1
