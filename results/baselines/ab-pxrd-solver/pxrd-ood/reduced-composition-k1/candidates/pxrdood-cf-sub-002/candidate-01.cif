data_from_pyxtal

_symmetry_space_group_name_H-M 'Pm'
_symmetry_Int_Tables_number                    6
_symmetry_cell_setting                monoclinic
_cell_length_a            3.799900
_cell_length_b            3.104100
_cell_length_c            7.296000
_cell_angle_alpha        90.000000
_cell_angle_beta        100.040000
_cell_angle_gamma        90.000000
_cell_volume             84.740415

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 'x, -y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
S      S        1     0.616924    0.000000    0.853781 1
S      S        1     0.102312    0.500000    0.437103 1
Zn     Zn       1     0.070330    0.500000    0.749267 1
Sr     Sr       1     0.543766    0.000000    0.245563 1
#END

