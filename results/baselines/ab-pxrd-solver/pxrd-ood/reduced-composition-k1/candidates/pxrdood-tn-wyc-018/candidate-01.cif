data_from_pyxtal

_symmetry_space_group_name_H-M 'C2'
_symmetry_Int_Tables_number                    5
_symmetry_cell_setting                monoclinic
_cell_length_a            7.572500
_cell_length_b            5.533100
_cell_length_c            3.789600
_cell_angle_alpha        90.000000
_cell_angle_beta        109.460000
_cell_angle_gamma        90.000000
_cell_volume            149.711435

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 'x+1/2, y+1/2, z'
4 '-x+1/2, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        4     0.802528    0.149047    0.000214 1
O      O        4     0.630360    0.334110    0.391080 1
O      O        2     0.000000    0.416063    0.500000 1
V      V        4     0.308184    0.908811    0.748599 1
#END

