data_from_pyxtal

_symmetry_space_group_name_H-M 'P21/m'
_symmetry_Int_Tables_number                   11
_symmetry_cell_setting                monoclinic
_cell_length_a            6.568600
_cell_length_b            6.560500
_cell_length_c            9.067600
_cell_angle_alpha        90.000000
_cell_angle_beta         90.040000
_cell_angle_gamma        90.000000
_cell_volume            390.752715

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z'
3 '-x, -y, -z'
4 'x, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
F      F        4     0.459322    0.505205    0.145319 1
F      F        2     0.433324    0.250000    0.671360 1
Cl     Cl       4     0.911966    0.499613    0.664353 1
Cl     Cl       2     0.852719    0.250000    0.035292 1
K      K        2     0.500000    0.000000    0.500000 1
K      K        2     0.283265    0.250000    0.983765 1
Sn     Sn       2     0.708802    0.250000    0.793479 1
#END

