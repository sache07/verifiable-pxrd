data_from_pyxtal

_symmetry_space_group_name_H-M 'P21/m'
_symmetry_Int_Tables_number                   11
_symmetry_cell_setting                monoclinic
_cell_length_a            4.178500
_cell_length_b            9.592000
_cell_length_c           25.858532
_cell_angle_alpha        90.000000
_cell_angle_beta         93.505070
_cell_angle_gamma        90.000000
_cell_volume           1034.475701

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z'
3 '-x, -y, -z'
4 'x, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Hf     Hf       2     0.043279    0.250000    0.002299 1
Hf     Hf       2     0.559173    0.250000    0.067809 1
Hf     Hf       2     0.493316    0.250000    0.556439 1
Hf     Hf       2     0.018597    0.250000    0.746913 1
Hf     Hf       2     0.007025    0.250000    0.617365 1
Hf     Hf       2     0.515841    0.250000    0.682406 1
Hf     Hf       2     0.520303    0.250000    0.810990 1
Hf     Hf       2     0.529937    0.250000    0.940857 1
Hf     Hf       2     0.977058    0.250000    0.490965 1
Hf     Hf       2     0.022494    0.250000    0.875577 1
