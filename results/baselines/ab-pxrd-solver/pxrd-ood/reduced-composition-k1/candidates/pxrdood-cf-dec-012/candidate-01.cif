data_from_pyxtal

_symmetry_space_group_name_H-M 'R-3'
_symmetry_Int_Tables_number                  148
_symmetry_cell_setting                  trigonal
_cell_length_a            5.523166
_cell_length_b            5.523166
_cell_length_c           13.688570
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            361.630442

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'
4 '-x, -y, -z'
5 'y, -x+y, -z'
6 'x-y, x, -z'
7 'x+2/3, y+1/3, z+1/3'
8 '-y+2/3, x-y+1/3, z+1/3'
9 '-x+y+2/3, -x+1/3, z+1/3'
10 '-x+2/3, -y+1/3, -z+1/3'
11 'y+2/3, -x+y+1/3, -z+1/3'
12 'x-y+2/3, x+1/3, -z+1/3'
13 'x+1/3, y+2/3, z+2/3'
14 '-y+1/3, x-y+2/3, z+2/3'
15 '-x+y+1/3, -x+2/3, z+2/3'
16 '-x+1/3, -y+2/3, -z+2/3'
17 'y+1/3, -x+y+2/3, -z+2/3'
18 'x-y+1/3, x+2/3, -z+2/3'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O       18     0.571239    0.978797    0.760481 1
Fe     Fe       3     0.000000    0.000000    0.500000 1
Ru     Ru       3     0.000000    0.000000    0.000000 1
Bi     Bi       6     0.000000    0.000000    0.230696 1
