data_from_pyxtal

_symmetry_space_group_name_H-M 'Immm'
_symmetry_Int_Tables_number                   71
_symmetry_cell_setting              orthorhombic
_cell_length_a            5.276573
_cell_length_b            9.090867
_cell_length_c            9.113742
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            437.173660

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-x, y, -z'
4 'x, -y, -z'
5 '-x, -y, -z'
6 'x, y, -z'
7 'x, -y, z'
8 '-x, y, z'
9 'x+1/2, y+1/2, z+1/2'
10 '-x+1/2, -y+1/2, z+1/2'
11 '-x+1/2, y+1/2, -z+1/2'
12 'x+1/2, -y+1/2, -z+1/2'
13 '-x+1/2, -y+1/2, -z+1/2'
14 'x+1/2, y+1/2, -z+1/2'
15 'x+1/2, -y+1/2, z+1/2'
16 '-x+1/2, y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
N      N        2     0.000000    0.000000    0.000000 1
O      O        8     0.000000    0.644163    0.650190 1
O      O        8     0.871561    0.000000    0.237137 1
O      O        8     0.758801    0.350442    0.000000 1
Mn     Mn       2     0.500000    0.500000    0.000000 1
Mn     Mn       2     0.000000    0.500000    0.500000 1
Mn     Mn       2     0.500000    0.000000    0.500000 1
Mn     Mn       8     0.250000    0.250000    0.250000 1
