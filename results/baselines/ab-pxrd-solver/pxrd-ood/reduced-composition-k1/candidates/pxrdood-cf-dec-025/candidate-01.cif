data_from_pyxtal

_symmetry_space_group_name_H-M 'P2/c'
_symmetry_Int_Tables_number                   13
_symmetry_cell_setting                monoclinic
_cell_length_a            8.451100
_cell_length_b            6.343800
_cell_length_c           12.036200
_cell_angle_alpha        90.000000
_cell_angle_beta        134.480000
_cell_angle_gamma        90.000000
_cell_volume            460.408248

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z+1/2'
3 '-x, -y, -z'
4 'x, -y, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Li     Li       4     0.038441    0.286981    0.505841 1
Li     Li       4     0.530259    0.285580    0.997759 1
Li     Li       2     0.000000    0.665847    0.250000 1
S      S        4     0.739675    0.513162    0.751557 1
Fe     Fe       2     0.500000    0.310484    0.250000 1
Te     Te       4     0.256541    0.945485    0.508166 1
