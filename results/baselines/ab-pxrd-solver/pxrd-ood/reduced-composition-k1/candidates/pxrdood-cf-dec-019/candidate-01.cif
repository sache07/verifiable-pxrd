data_from_pyxtal

_symmetry_space_group_name_H-M 'P2/m'
_symmetry_Int_Tables_number                   10
_symmetry_cell_setting                monoclinic
_cell_length_a            5.400100
_cell_length_b            5.125900
_cell_length_c            7.333978
_cell_angle_alpha        90.000000
_cell_angle_beta         94.204234
_cell_angle_gamma        90.000000
_cell_volume            202.460977

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 '-x, -y, -z'
4 'x, -y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        1     0.500000    0.500000    0.500000 1
F      F        4     0.206620    0.266972    0.687687 1
F      F        4     0.771986    0.729098    0.818829 1
F      F        1     0.500000    0.500000    0.000000 1
F      F        1     0.500000    0.000000    0.000000 1
F      F        1     0.500000    0.000000    0.500000 1
Cr     Cr       2     0.987494    0.000000    0.754789 1
Mo     Mo       2     0.507446    0.500000    0.260550 1
#END

