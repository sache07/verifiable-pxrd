data_from_pyxtal

_symmetry_space_group_name_H-M 'Cc'
_symmetry_Int_Tables_number                    9
_symmetry_cell_setting                monoclinic
_cell_length_a           10.874500
_cell_length_b           10.862800
_cell_length_c            7.586700
_cell_angle_alpha        90.000000
_cell_angle_beta        134.180000
_cell_angle_gamma        90.000000
_cell_volume            642.711942

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 'x, -y, z+1/2'
3 'x+1/2, y+1/2, z'
4 'x+1/2, -y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ti     Ti       4     0.574787    0.471591    0.368476 1
Cu     Cu       4     0.068424    0.616593    0.039264 1
Se     Se       4     0.337727    0.497733    0.354666 1
Se     Se       4     0.084362    0.765515    0.810944 1
Se     Se       4     0.082257    0.257624    0.839424 1
Se     Se       4     0.812967    0.489528    0.828134 1
Mo     Mo       4     0.839476    0.758471    0.330519 1
