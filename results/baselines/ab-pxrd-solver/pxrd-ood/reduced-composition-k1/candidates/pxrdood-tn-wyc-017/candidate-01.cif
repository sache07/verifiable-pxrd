data_from_pyxtal

_symmetry_space_group_name_H-M 'Pmmn'
_symmetry_Int_Tables_number                   59
_symmetry_cell_setting              orthorhombic
_cell_length_a            6.762130
_cell_length_b            7.260574
_cell_length_c           11.697514
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            574.312115

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y+1/2, z'
3 '-x, y+1/2, -z'
4 'x+1/2, -y, -z'
5 '-x, -y, -z'
6 'x+1/2, y+1/2, -z'
7 'x, -y+1/2, z'
8 '-x+1/2, y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        4     0.250000    0.910670    0.016989 1
O      O        4     0.250000    0.925219    0.275069 1
O      O        2     0.250000    0.250000    0.131409 1
Na     Na       2     0.250000    0.750000    0.430921 1
V      V        4     0.250000    0.011292    0.142124 1
