data_from_pyxtal

_symmetry_space_group_name_H-M 'P-6'
_symmetry_Int_Tables_number                  174
_symmetry_cell_setting                 hexagonal
_cell_length_a            5.558731
_cell_length_b            5.558731
_cell_length_c            4.470530
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            119.630256

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'
4 'x, y, -z'
5 '-y, x-y, -z'
6 '-x+y, -x, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
N      N        1     0.333333    0.666667    0.500000 1
Ti     Ti       3     0.686386    0.659099    0.500000 1
Ti     Ti       3     0.021818    0.545379    0.000000 1
Bi     Bi       1     0.000000    0.000000    0.000000 1
#END

