data_from_pyxtal

_symmetry_space_group_name_H-M 'Pm'
_symmetry_Int_Tables_number                    6
_symmetry_cell_setting                monoclinic
_cell_length_a            6.526900
_cell_length_b           21.249500
_cell_length_c            8.169830
_cell_angle_alpha        90.000000
_cell_angle_beta         96.517541
_cell_angle_gamma        90.000000
_cell_volume           1125.778183

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 'x, -y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        1     0.095775    0.500000    0.927605 1
O      O        1     0.109715    0.500000    0.376169 1
O      O        1     0.241049    0.500000    0.532781 1
O      O        1     0.661513    0.000000    0.250046 1
O      O        1     0.804222    0.000000    0.646881 1
O      O        1     0.348186    0.000000    0.639933 1
In     In       1     0.550603    0.000000    0.470298 1
In     In       1     0.988565    0.500000    0.683491 1
Ba     Ba       1     0.604509    0.000000    0.887875 1
Ba     Ba       1     0.898230    0.500000    0.146621 1
