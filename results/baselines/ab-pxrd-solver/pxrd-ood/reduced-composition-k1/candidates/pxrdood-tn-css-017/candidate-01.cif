data_from_pyxtal

_symmetry_space_group_name_H-M 'P-6'
_symmetry_Int_Tables_number                  174
_symmetry_cell_setting                 hexagonal
_cell_length_a            8.783484
_cell_length_b            8.783484
_cell_length_c            2.731997
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            182.534263

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'
4 'x, y, -z'
5 '-y, x-y, -z'
6 '-x+y, -x, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Co     Co       3     0.519631    0.748222    0.500000 1
Co     Co       3     0.211223    0.229996    0.000000 1
Ge     Ge       3     0.974572    0.200155    0.500000 1
Ge     Ge       3     0.018538    0.523460    0.000000 1
Zr     Zr       1     0.666667    0.333333    0.500000 1
#END

