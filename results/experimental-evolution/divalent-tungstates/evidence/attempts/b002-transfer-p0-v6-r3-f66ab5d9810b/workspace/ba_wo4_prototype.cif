  4  'y+1/2, -x, z+3/4'
  5  '-x, -y+1/2, -z+1/4'
  6  'y, -x, -z'
  7  'x+1/2, y, -z+3/4'
  8  '-y+1/2, x+1/2, -z+1/2'
  9  'x+1/2, y+1/2, z+1/2'
  10 '-y+1/2, x, z+3/4'
  11 '-x, -y, z'
  12 'y, -x+1/2, z+1/4'
  13 '-x+1/2, -y, -z+3/4'
  14 'y+1/2, -x+1/2, -z+1/2'
  15 'x, y+1/2, -z+1/4'
  16 '-y, x, -z'
