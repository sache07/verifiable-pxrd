# Prefer generating this file with `uv run vpbench setup-runtime`.
# These are non-secret, machine-local paths and may be used in bash or zsh.
export VPBENCH_CODEX="$HOME/.local/bin/codex"
export VPBENCH_MATSCI_ENV="$HOME/.local/share/verifiable-pxrd/matsci"
export VPBENCH_GSAS_ENV="$HOME/.local/share/verifiable-pxrd/gsas2/venv"

# Optional read-only local COD resources:
# export VPBENCH_COD_METADATA="/absolute/path/to/cod-metadata.json.gz"
# export VPBENCH_COD_CIFS="/absolute/path/to/cod-cifs"
